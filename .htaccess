# Configuracao para hospedagem compartilhada (InfinityFree / page.gd).
# Na VPS (Caddy) este arquivo e bloqueado e nunca e servido.
#
# O que faz:
#  - mostra index.html como padrao de cada pasta (/painel, /afiliados, ...);
#  - usa a pagina 404.html do proprio site em vez da pagina de erro do host;
#  - bloqueia listagem de diretorios (nada de /assets/ ou /painel/ abertos);
#  - proibe leitura de arquivos internos (.env, .git, logs, backups).

DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /404.html

# Redirecionamento do apelido antigo (/criadores) para a página atual.
# Nao se mexe na barra final: o proprio Apache cuida disso (mod_dir) e uma
# regra invertida aqui criaria um laco de redirecionamento.
Redirect 301 /criadores /afiliados/
Redirect 301 /criadores/ /afiliados/

# Arquivos internos: nao devem ser lidos nem pelo servidor.
<FilesMatch "(^\.|^.*\.(md|log|sqlite|sqlite-wal|sqlite-shm|bak|sql|ini|sh|py)$)">
  Require all denied
</FilesMatch>

# Cabecalho de seguranca basico (o InfinityFree ja adiciona os seus).
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Cache dos arquivos de imagem e fonte: podem ser guardados por um ano.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>

# Compressao do texto (o InfinityFree ja comprime, mas nao atrapalha repetir).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>
