[Unit]
Description=Entrega a fila de e-mail do vizin.Os (PC -> Gmail)
Documentation=https://github.com/dietmilkk/vizin-Os-Website
# A rede sobe depois do boot; o script espera 60s antes de comecar.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/home/user/Downloads/site/tools/rodar-gateway-email.sh
Environment=ATRASO_INICIAL=60
Environment=NICE=10
Environment=MAIL_QUEUE_URL=https://api.188.166.156.109.sslip.io

# Recomeca se o puxador cair (rede, VPS fora do ar, etc.).
Restart=on-failure
RestartSec=60

# Uso minimo de recursos: prioridade baixa de CPU, teto de 25% de um nucleo
# e teto de memoria. O gateway fica ocioso quase o tempo todo, entao o
# consumo real fica em poucos MB.
Nice=10
CPUWeight=10
CPUQuota=25%
MemoryMax=512M

# Ao parar o serviço, o tunel e o gateway morrem junto.
KillMode=control-group
TimeoutStopSec=20

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
